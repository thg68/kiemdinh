{
  "name": "kiemdinh-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/run-with-node22.mjs next build",
    "build:next": "next build",
    "clean:cloudflare": "node scripts/clean-cloudflare-build.mjs",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:rls": "supabase test db",
    "typecheck": "next typegen && tsc --noEmit",
    "design:check": "impeccable detect app components",
    "icons:build": "node scripts/build-favicon.mjs",
    "import:school-year": "node scripts/import-school-year.mjs",
    "preview": "node scripts/run-with-node22.mjs npm run preview:cloudflare",
    "preview:cloudflare": "npm run clean:cloudflare && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run deploy:production",
    "deploy:cloudflare": "npm run deploy:production",
    "upload": "node scripts/run-with-node22.mjs npm run upload:cloudflare",
    "upload:cloudflare": "npm run clean:cloudflare && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:staging-env": "node scripts/validate-deployment-env.mjs staging",
    "check:production-env": "node scripts/validate-deployment-env.mjs production",
    "deploy:staging": "node scripts/run-with-node22.mjs node scripts/run-with-deployment-env.mjs staging npm run deploy:staging:cloudflare",
    "deploy:staging:cloudflare": "npm run check:staging-env && npm run clean:cloudflare && opennextjs-cloudflare build --env=staging && opennextjs-cloudflare deploy --env=staging -- --keep-vars",
    "deploy:production": "node scripts/run-with-node22.mjs node scripts/run-with-deployment-env.mjs production npm run deploy:production:cloudflare",
    "deploy:production:cloudflare": "npm run check:production-env && npm run clean:cloudflare && opennextjs-cloudflare build --env=production && opennextjs-cloudflare deploy --env=production -- --keep-vars",
    "rollback:production": "node scripts/run-with-node22.mjs wrangler rollback --env production",
    "check:pilot": "node scripts/check-pilot-readiness.mjs",
    "verify:mau1": "node scripts/verify-mau1.mjs",
    "provision:e2e:staging": "node scripts/provision-staging-e2e.mjs",
    "test:e2e:staging:roles": "node scripts/run-with-node22.mjs node scripts/run-staging-role-gate.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/supabase-js": "^2.112.3",
    "archiver": "^7.0.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.44.0",
    "next": "16.3.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^6.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "impeccable": "^3.6.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
